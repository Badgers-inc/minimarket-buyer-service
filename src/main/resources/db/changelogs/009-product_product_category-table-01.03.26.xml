<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="9" author="rasan">
        <createTable tableName="product_product_category" schemaName="buyer_application">
            <column name="product_id" type="UUID" remarks="ссылка на товар">
                <constraints nullable="false" unique="false"
                             foreignKeyName="fk_product_product_category_product"
                             referencedTableName="product"
                             referencedColumnNames="id"/>
            </column>
            <column name="category_id" type="bigint" remarks="ссылка на категорию">
                <constraints nullable="false" unique="false"
                             foreignKeyName="fk_product_product_category_product_category"
                             referencedTableName="product_category"
                             referencedColumnNames="id"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="product_product_category"
                             schemaName="buyer_application"
                             columnNames="product_id, category_id"
                             constraintName="uq_product_category"/>
    </changeSet>

</databaseChangeLog>