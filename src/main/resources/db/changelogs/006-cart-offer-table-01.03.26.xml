<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="6" author="rasan">
        <createTable tableName="cart_offer" schemaName="buyer_application">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints nullable="false" unique="true"
                             primaryKey="true"/>
            </column>
            <column name="cart_id" type="bigint">
                <constraints nullable="false" unique="true"
                             foreignKeyName="cart_offer_cart_fk"
                             referencedTableName="cart"
                             referencedColumnNames="id"/>
            </column>
            <column name="offer_id" type="UUID">
                <constraints nullable="false" unique="false"
                             foreignKeyName="cart_offer_offer_fk"
                             referencedTableName="offer"
                             referencedColumnNames="id"/>
            </column>
            <column name="quantity" type="int">
                <constraints nullable="false" unique="false"/>
            </column>
            <column name="order_id" type="bigint">
                <constraints nullable="false" unique="false"
                             foreignKeyName="cart_offer_order_fk"
                             referencedTableName="orders"
                             referencedColumnNames="id"/>
            </column>
            <column name="price_at_purchase" type="decimal(10,2)">
                <constraints nullable="false" unique="false"/>
            </column>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false" unique="false"/>
            </column>
            <column name="updated_at" type="timestamptz">
                <constraints nullable="true" unique="false"/>
            </column>
            <column name="active" type="boolean">
                <constraints nullable="false" unique="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>