<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="7" author="rasan">
        <createTable tableName="orders" schemaName="buyer_application">
            <column name="id" type="bigint" autoIncrement="true" remarks="идентификатор, генерируется">
                <constraints nullable="false" unique="true"
                             primaryKey="true"/>
            </column>
            <column name="completed" type="boolean" remarks="завершен ли заказ; true после завершения покупки"
                    defaultValue="false">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>